{
  "name": "toolyard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/gen-registry.mjs",
    "registry": "node scripts/gen-registry.mjs",
    "dev": "npm run registry && next dev",
    "build": "npm run registry && next build",
    "start": "next start",
    "db:push": "tsx scripts/db.ts push",
    "db:seed": "tsx scripts/db.ts seed",
    "db:reset": "tsx scripts/db.ts reset",
    "tool:new": "tsx scripts/new-tool.ts",
    "setup": "npm run registry && npm run db:reset",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run registry && npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.56.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "4.21.4",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
